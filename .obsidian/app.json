{
  "userIgnoreFilters": [
    "node_modules/**",
    ".next/**",
    ".git/**",
    ".vscode/**",
    "public/**",
    "dist/**",
    "build/**",
    "yarn.lock",
    "package-lock.json",
    "scratch/**"
